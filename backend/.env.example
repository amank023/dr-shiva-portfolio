# Server Port
PORT=5000

# Admin Portal Master Password
ADMIN_PASSWORD=Admin@123

# ==============================================================================
# FIREBASE CLOUD FIRESTORE CONFIGURATION
# ==============================================================================
# You can connect to Firebase using ANY of the 3 methods below:

# ── METHOD 1 (Recommended): Place the downloaded Service Account JSON file ────
# Download from: Firebase Console -> Project Settings -> Service accounts -> Generate new private key
# Rename and place the file in the "backend" directory as: firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# ── METHOD 2: Paste the entire Service Account JSON string ────────────────────
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'

# ── METHOD 3: Set Individual Environment Variables ───────────────────────────
# FIREBASE_PROJECT_ID=dr-shiva-portfolio-XXXXX
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@dr-shiva-portfolio-XXXXX.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
